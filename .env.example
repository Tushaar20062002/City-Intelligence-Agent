# .env.example
# Copy this file to a new file named .env and fill in your actual API keys.
# Do NOT commit your actual .env file to version control (GitHub).

# Groq API Key (Required for the LLM to function)
# Get it here: https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# Tavily API Key (Required for latest news and search)
# Get it here: https://app.tavily.com/
Tavily_API_KEY="your_tavily_api_key_here"

# OpenRouteService API Key (Required for routing and directions)
# Get it here: https://openrouteservice.org/dev/#/signup
OpenRouteService_API="your_openrouteservice_api_key_here"
